{
  "name": "echea",
  "version": "0.1.0",
  "private": true,
  "description": "Échéa — fichier Passeport de prévention et relances de recyclages pour les organismes de formation, 100 % dans le navigateur.",
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.js",
    "build": "vite build --config app/vite.config.js",
    "preview": "vite preview --config app/vite.config.js --port 4173 --strictPort",
    "test": "vitest run --config app/vite.config.js",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
    "license:init": "node scripts/license/license.mjs init",
    "license:issue": "node scripts/license/license.mjs issue"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "papaparse": "^5.7.0",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
